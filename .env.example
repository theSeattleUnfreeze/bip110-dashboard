# ---------------------------------------------------------------------
# CANONICAL NODE: does NOT enforce BIP-110 (Bitcoin Core).
#
# Follows the majority chain no matter what, so it is the default for all
# endpoints. Do not put a Knots node with reduced_data here: from block
# 961,632 it may follow the minority chain and the dashboard would treat
# that as the main chain.
#
# To see which node is which:
#   bitcoin-cli getnetworkinfo    -> check localservicesnames for REDUCED_DATA
#   bitcoin-cli getdeploymentinfo -> check for the reduced_data deployment
#
# You can set BOTH clearnet and Tor URLs. One is used — the first that
# responds; if it stops responding, the other is tried. Clearnet first
# because it is much faster; from a VPS clearnet fails in seconds and Tor
# is used with no config change.
# ---------------------------------------------------------------------
# Include the scheme: http://. Without it curl works (it assumes http) but
# libraries do not; the app adds it if missing.
BTC_RPC_URL=http://STARTOS_HOST:8332
# BTC_RPC_TOR_URL=http://yourhiddenervicexxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.onion:8332

BTC_RPC_USER=your_rpc_user
BTC_RPC_PASSWORD=your_rpc_password

# ---------------------------------------------------------------------
# BIP-110 NODE (Bitcoin Knots with reduced_data). Optional.
#
# Without it the dashboard still runs but /api/chain cannot compare chains
# and cannot detect a split after block 961,632.
# If you omit user/password here, the canonical credentials above are reused.
#
# Must NOT be the same URL as the canonical node. That would compare a node
# to itself, everything would look green, and a split would never be
# detected. /api/health warns about this.
# ---------------------------------------------------------------------
# BTC_RPC_URL_KNOTS=http://OTHER_HOST:8332
# BTC_RPC_TOR_URL_KNOTS=http://otherhiddenervicexxxxxxxxxxxxxxxxxxxxxxxxxxxx.onion:8332
# BTC_RPC_USER_KNOTS=
# BTC_RPC_PASSWORD_KNOTS=

# How long the chosen RPC URL is remembered. Invalidated as soon as a call fails,
# so a clearnet outage recovers on the next request.
# RPC_PICK_TTL=120
# Clearnet probe timeout during URL pick — must fail fast.
# RPC_PROBE_TIMEOUT=6

# ---------------------------------------------------------------------
# P2P crawl (biased sample — see crawler.py)
#
# CRAWL_VIA_TOR=true routes the entire crawl through Tor: hides the VPS IP
# but is much slower. When false, IPv4/IPv6 go out in clearnet from the VPS
# and only .onion addresses use Tor.
# ---------------------------------------------------------------------
CRAWL_VIA_TOR=false
CRAWL_MAX_NODES=250

# Include .onion nodes in the crawl. Tor is considered "up" if any of:
# CRAWL_VIA_TOR=true, a node URL is .onion, or SOCKS is listening on
# TOR_HOST:TOR_PORT.
#
# The third case is checked by opening the port, not inferred from config.
# Matters when the node is onlynet=onion: no clearnet peers, and dropping
# .onion seeds would leave the crawl with nothing to do even with Tor up.
CRAWL_INCLUDE_ONION=true

# Seeds taken from getpeerinfo on your own nodes.
CRAWL_MAX_SEEDS=60

# Empty = automatic based on Tor use. Tune only if needed.
# CRAWL_THREADS=16
# CRAWL_TIMEOUT=8
# CRAWL_BUDGET=180

# Tor SOCKS proxy. Inside the container the entrypoint starts Tor itself.
# TOR_HOST=127.0.0.1
# TOR_PORT=9050
# TOR_SOCKS=socks5h://127.0.0.1:9050

# i2p and cjdns are not crawled: would need routers on those networks,
# which this container does not run. The UI labels that limitation.

# ---------------------------------------------------------------------
# Samples
# ---------------------------------------------------------------------
# Recent blocks used to estimate each pool's share.
# Larger sample = more precision but slower (much slower over Tor).
POOLS_SAMPLE=500

# Blocks per request when fetching coinbases. A current block at verbosity=1
# is ~250 KB JSON, so large batches mean tens of MB and often fail over Tor.
# Empty = 15 over Tor, 60 on clearnet. Do not raise without measuring.
# POOLS_CHUNK=

# Closed retarget periods shown in history. Cached on disk permanently
# because a closed period is immutable.
HISTORY_PERIODS=5

# /api/health wait cap. A health endpoint that takes half a minute is useless:
# the supervisor kills a container that is still alive. Both nodes are queried
# in parallel, so this is the total budget.
# Over Tor latency varies a lot per request, so the cap follows the route:
# if any .onion URL is configured, the Tor timeout is used.
HEALTH_TIMEOUT=12
HEALTH_TIMEOUT_TOR=35

# ---------------------------------------------------------------------
# In-memory cache (seconds)
# ---------------------------------------------------------------------
MINERS_TTL=300
POOLS_TTL=3600
NODES_TTL=3600
HISTORY_TTL=3600
# Chain comparison: cheap (~20 RPC calls), can stay fresh.
CHAINS_TTL=60

# ---------------------------------------------------------------------
# Persistence. Closed periods and split height live here; they must not be
# lost — split height is a historical fact. In Docker this is a volume.
# ---------------------------------------------------------------------
# CACHE_DIR=/data
